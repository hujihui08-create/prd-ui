      "assumptions": [
        {
          "id": "A-001",
          "statement": "预约列表按 §5.3 的六个字段编译；跨店行的门店名展示由 Q-001 决定，本候选不先行增加 store 字段。"
        },
        {
          "id": "A-002",
          "statement": "预约列表的页面级必需状态沿用 §4.1 的 default、empty、loading、error；只读档位下「新增预约」按钮的禁用行为由 Q-002 明确。"
        },
        {
          "id": "A-003",
          "statement": "预约列表空态统一使用「当前条件下暂无预约」并提供清空筛选；真空态、筛选无结果和条件无结果的拆分由 Q-003 决定。"
        },
        {
          "id": "A-004",
          "statement": "只读档位下新增/改期预约保留表单并整体置灰，符合 §4.1「表单只读」；入口隐藏方案由 Q-004 决定。"
        },
        {
          "id": "A-005",
          "statement": "改期模式沿用 /appointments/new 路由，并通过页面参数传入预约 id；具体参数名由 Q-005 决定。"
        },
        {
          "id": "A-006",
          "statement": "预约详情对店长、美容师、前台、库管均可见；仅勾选「开单」功能点时的可见性由 Q-006 决定。"
        },
        {
          "id": "A-007",
          "statement": "预约列表默认按时间倒序，支持下拉刷新、上拉加载与「没有更多」，沿用 §10 共享规则；验收示例补充由 Q-007 决定。"
        },
        {
          "id": "A-008",
          "statement": "预约详情底部动作按业务状态矩阵渲染：已登记显示已到店确认、开单、改期、取消；已到店只显示开单；爽约与已取消不显示操作栏；待分配时到店确认文案为「接单并确认到店」。"
        },
        {
          "id": "A-009",
          "statement": "列表与详情中的客户手机号一律脱敏，不提供完整号或拨号入口。"
        },
        {
          "id": "A-010",
          "statement": "示例姓名、手机号、时间与告知文本均仅用于展示，不代表真实客户或业务数据。"
        },
        {
          "id": "A-011",
          "statement": "术后告知主入口来自切片外的服务完成流程或客户详情服务记录，本切片只编译告知页本身。"
        },
        {
          "id": "A-012",
          "statement": "取消操作在预约详情触发二次确认，确认后状态变为已取消并回到只读说明。"
        }
