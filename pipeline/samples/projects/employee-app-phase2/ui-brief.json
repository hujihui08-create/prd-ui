    {
      "id": "Q-001",
      "question": "客户搜索页是否显示新建客户入口？",
      "blocking": false
    },
    {
      "id": "Q-002",
      "question": "客户详情的「查看预约」应打开哪条预约？",
      "blocking": false
    },
    {
      "id": "Q-003",
      "question": "预约详情的「客户详情」入口是否仍受预约业务状态限制？",
      "blocking": false
    },
    {
      "id": "Q-004",
      "question": "术后告知内容为空是否作为独立空态纳入页面状态矩阵？",
      "blocking": false
    },
    {
      "id": "Q-005",
      "question": "日历块点击后的只读抽屉包含哪些字段与动作？",
      "blocking": false
    },
    {
      "id": "Q-006",
      "question": "从今日「预约」快捷操作新增预约时，客户字段如何选择或预填？",
      "blocking": false
    },
    {
      "id": "Q-007",
      "question": "日历默认展示哪一周，每天展示的起止时间是几点到几点？",
      "blocking": false
    }
