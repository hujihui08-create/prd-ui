  "openQuestions": [
    {
      "id": "Q-001",
      "question": "客户详情页的「查看预约」入口放在哪里、进入哪一条预约详情？客户有多条预约时是只允许看最近一条，还是需要预约列表？",
      "blocking": false
    },
    {
      "id": "Q-002",
      "question": "术后告知的「暂无告知内容」是否应作为 empty 或独立内容态纳入状态矩阵？",
      "blocking": false
    },
    {
      "id": "Q-003",
      "question": "日历块点击后应直接进入 appointment-detail，还是先打开只读抽屉再由「查看完整详情」进入？以哪条为准？",
      "blocking": false
    },
    {
      "id": "Q-004",
      "question": "回访登记的服务项目从哪里取值（待回访条目带入、预约项目选择或自由填写）？本切片回访是否绑定具体预约？",
      "blocking": false
    },
    {
      "id": "Q-005",
      "question": "项目与护理师字段的候选数据来自哪里（项目目录、门店员工列表）？首版是否允许自由输入？",
      "blocking": false
    },
    {
      "id": "Q-006",
      "question": "今日「我的预约」是否与预约列表「我的排单」同口径（含跨店行）？若是，门店名在今日行内如何展示？",
      "blocking": false
    },
    {
      "id": "Q-007",
      "question": "取消预约是否统一使用二次确认弹窗？弹窗标题、正文与确认、取消按钮文案是什么？",
      "blocking": false
    }
  ],
  "assumptions": [
    {
      "id": "A-001",
      "statement": "客户详情「查看预约」入口置于最近服务记录行，打开该记录关联的预约详情并携带 appointmentId；无关联预约时不显示该入口。"
    },
    {
      "id": "A-002",
      "statement": "术后告知不新增页面状态；noticeBlocks 与 notices 皆空时按内容空态只读显示「暂无告知内容」，不显示确认按钮。"
    },
    {
      "id": "A-003",
      "statement": "预约列表日历块点击先打开只读详情抽屉，抽屉内「查看完整详情」进入预约详情；列表行直接进入预约详情。"
    },
    {
      "id": "A-004",
      "statement": "回访登记的服务项目由来源待回访条目带入，并可在表单内改选；本切片回访不绑定 appointmentId。"
    },
    {
      "id": "A-005",
      "statement": "新增与改期表单的项目、护理师为选择器，候选分别来自门店项目目录与门店员工列表；首版不允许自由输入。"
    },
    {
      "id": "A-006",
      "statement": "今日「我的预约」与预约列表「我的排单」同口径并可含跨店行；门店名作为行内附加文案展示，不新增字段。"
    },
    {
      "id": "A-007",
      "statement": "取消预约统一使用二次确认弹窗，标题「取消预约」，正文「确认取消该预约？」，按钮「确认取消」「再想想」。"
    },
    {
      "id": "A-008",
      "statement": "今日待回访的客户、项目与天数示例为示意数据，用于展示区块结构，不代表真实业务记录。"
    },
    {
      "id": "A-009",
      "statement": "术后告知的分块话术为示意文案，实际展示以服务完成时冻结的告知快照为准。"
    },
    {
      "id": "A-010",
      "statement": "客户详情无备注时显示「暂无备注」；有备注时按备注原文展示。"
    },
    {
      "id": "A-011",
      "statement": "所有页面与动作回显的手机号一律脱敏，演示数据使用 138****0000 等掩码格式，不出现完整号与拨号入口。"
    }
  ],
