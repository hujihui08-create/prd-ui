  "product": {
    "name": "员工端小程序",
    "type": "微信小程序（uni-app），门店一线员工移动工作台",
    "goals": [
      "让门店一线员工在服务现场完成客户查找、预约接待、术后告知与回访登记",
      "通过业务状态与动作的强约束保证预约操作与当前状态一致",
      "在移动端提供日历与列表两种预约查看维度，兼顾排单节奏与逐条查看"
    ],
    "users": [
      "店长",
      "美容师",
      "前台"
    ],
    "roles": [
      "store_manager",
      "beautician",
      "front_desk"
    ],
    "scope": [
      "今日：门店与消息、快捷操作、我的预约、待回访",
      "客户搜索与客户详情：按姓名或脱敏手机号搜索、查看客户基础信息、卡项与消费摘要",
      "预约：预约详情、到店确认、改期、取消、新增、日历与列表双维度、术后告知",
      "回访：登记回访内容与结果",
      "全链路手机号脱敏与只读档位下写操作置灰拦截"
    ],
    "nonGoals": [
      "开单三步流程、订单详情、收款与签字",
      "库存入库、出库、调拨、欠款还款、个人业绩、我的、消息与公告",
      "Web 专属操作：整单作废、冲正、盘点、退卡、催收登记、客户档案编辑",
      "爽约入口：员工端不提供爽约操作，爽约状态只读可见",
      "客户 Tab 默认客户列表与新建客户表单，由宿主提供",
      "工作台、库存、客户 Tab 默认列表等宿主页面"
    ],
    "successMetrics": [
      "8 页主流程可在移动端完成接待、查客户、到店确认、改期或取消、术后告知与回访登记",
      "手机号在所有页面与动作回显中保持脱敏，不出现完整号与拨号入口",
      "只读档位下全部写操作置灰并由系统拦截，读操作正常",
      "无权限动作不出现，页面可见性与角色表一致"
    ]
  },
