  "product": {
    "name": "员工端小程序",
    "type": "微信小程序",
    "goals": [
      "支持门店一线员工在服务现场完成接待、查客户、确认到店、改期或取消、术后告知与回访登记。",
      "在移动端提供今日工作入口与预约日历、列表双维度视图。",
      "按角色与功能点控制页面和动作可见性，并在只读档位拦截写操作。",
      "全链路展示脱敏手机号，不提供完整号与拨号。"
    ],
    "users": [
      "店长",
      "美容师",
      "前台",
      "库管"
    ],
    "roles": [
      "store_manager",
      "beautician",
      "front_desk",
      "warehouse"
    ],
    "scope": [
      "今日：门店、快捷操作、我的预约、待回访",
      "客户搜索与客户详情",
      "预约详情与业务状态动作",
      "新增或改期预约表单",
      "术后告知分块展示与确认",
      "预约列表日历与列表双维度",
      "回访登记",
      "角色与动作级权限、只读档位、手机号脱敏"
    ],
    "nonGoals": [
      "开单三步流程、订单详情、收款与签字",
      "库存入库、出库、调拨、欠款还款、个人业绩、我的、消息与公告",
      "Web 专属操作：整单作废、冲正、盘点、退卡、催收登记、客户档案编辑",
      "员工端爽约操作；爽约状态仅只读可见",
      "客户默认列表与完整新建客户表单",
      "独立改派按钮；改派通过改期表单修改护理师完成",
      "宿主页面导航与宿主流程页面"
    ],
    "successMetrics": [
      "PRD 验收示例 1–11 全部可在 8 页切片内走查",
      "四类角色按页面与动作权限看到对应入口，无权限动作不出现",
      "只读档位下所有写操作置灰并由系统拦截",
      "所有页面与动作回显的手机号均为脱敏格式",
      "术后告知内容为空时展示「暂无告知内容」空态且不显示确认按钮"
    ]
  },
