      "admin",
      "operator",
      "viewer"
    ],
    "scope": [
      "web：orders-overview、orders-list、order-detail、order-form、settings",
      "mobile：home-feed、item-detail、auth",
      "页面级角色可见性：settings 仅 admin；web 订单页面 admin/operator；mobile 页面 viewer/admin",
      "8 条需求 REQ-ORDER-001 至 REQ-ORDER-008 均有页面归属"
    ],
    "nonGoals": [
      "支付渠道",
      "退款",
      "库存与履约系统",
      "多租户",
      "注册与找回密码",
      "第三方登录"
