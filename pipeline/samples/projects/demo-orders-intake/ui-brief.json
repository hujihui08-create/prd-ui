  "openQuestions": [
    {
      "id": "Q-001",
      "question": "订单概览的「待处理」和「异常」分别对应 Order.status 的哪些值或组合条件？四项指标是计数还是比例？",
      "blocking": false
    },
    {
      "id": "Q-002",
      "question": "商品详情「立即购买」进入的下单流程对应哪个页面或路由？viewer 在该流程中的权限是什么？",
      "blocking": false
    },
    {
      "id": "Q-003",
      "question": "order-detail 的编辑态是页内编辑还是独立路由或复用 order-form？可编辑字段、保存与取消行为是什么？",
      "blocking": false
    },
    {
      "id": "Q-004",
      "question": "orders-list 筛选栏包含哪些字段和控件？日期筛选是范围还是单日？状态默认值与可选项是什么？",
      "blocking": false
    },
    {
      "id": "Q-005",
      "question": "auth 在邮箱校验未通过时，登录按钮应禁用还是保持可点击并在提交后展示字段错误？字段错误在何时触发？",
      "blocking": false
    },
    {
      "id": "Q-006",
      "question": "无权限提示是否作为 settings 及所有角色受限页面的必需状态纳入状态矩阵？",
      "blocking": false
    },
    {
      "id": "Q-007",
      "question": "item-detail 的 price 类型、币种和格式是什么？auth 的 email、password 是否必填，校验规则是什么？",
      "blocking": false
    },
    {
      "id": "Q-008",
      "question": "新建订单时 customer 是选择已有客户还是输入名称？若需要新建客户，phone 与 email 在哪个页面采集？",
      "blocking": false
    },
    {
      "id": "Q-009",
      "question": "orders-overview 的近期订单列表包含哪些列、多少条、时间窗口是什么？无近期订单时是否需要 empty 状态？",
      "blocking": false
    },
    {
      "id": "Q-010",
      "question": "settings 保存成功反馈以什么形式呈现（内联提示、toast 还是页面状态），持续多久？",
      "blocking": false
    }
  ],
  "assumptions": [
    {
      "id": "A-001",
      "statement": "订单金额以人民币（CNY）计，保留两位小数。"
    },
    {
      "id": "A-002",
      "statement": "Phase 1 仅包含登录，不包含注册、找回密码与第三方登录。"
    },
    {
      "id": "A-003",
      "statement": "商品详情字段由内容服务提供，Phase 1 不纳入订单数据模型。"
    },
    {
      "id": "A-004",
      "statement": "Phase 1 权限仅做页面级可见性控制，不细化到字段级。"
    },
    {
      "id": "A-005",
      "statement": "orders-overview 固定渲染今日订单、待处理、已完成、异常四个指标卡；指标数值由运行期数据提供。"
    },
    {
      "id": "A-006",
      "statement": "item-detail 的「立即购买」保留为页面主操作；brief 不新增 C 端下单页面或路由。"
    },
    {
      "id": "A-007",
      "statement": "order-detail 的「编辑订单」不新增独立路由，编辑界面归属 order-detail 页面内。"
    },
    {
      "id": "A-008",
      "statement": "orders-list 以 status、createdAt、customer 三个字段承接状态、日期与关键字筛选。"
    },
    {
      "id": "A-009",
      "statement": "auth 的邮箱格式错误在提交校验后以字段错误展示；登录按钮仅在登录请求期间进入 disabled。"
    },
    {
      "id": "A-010",
      "statement": "角色受限页面在无权访问时展示无权限提示且不渲染页面数据；brief 不新增 forbidden 状态，requiredStates 沿用 PRD 状态矩阵。"
    },
    {
      "id": "A-011",
      "statement": "item-detail 的 title、price、description 作为 Product 内容实体建模；price 为数值型金额，title 与 description 为文本；auth 的 email、password 作为 AuthCredentials 实体建模，二者均为必填文本字段。"
    },
    {
      "id": "A-012",
      "statement": "order-form 的 customer 为客户名称文本输入；Customer.phone 与 Customer.email 不在 Phase 1 页面中采集。"
    },
    {
      "id": "A-013",
      "statement": "orders-overview 的近期订单列表按 Order 的 orderNo、customer、amount、status、createdAt 展示；条数与时间窗口不在 brief 中固化。"
    },
    {
      "id": "A-014",
      "statement": "settings 保存成功后展示成功反馈，但不新增 success 状态，requiredStates 沿用 PRD 状态矩阵。"
    }
  ],
