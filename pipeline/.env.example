# Asset reviewer model: DeepSeek vision endpoint (OpenAI-compatible protocol).
# Set these explicitly; there is no OpenAI default and no provider fallback.
# This file is NOT loaded automatically: `set -a; . ./.env; set +a`.
PRD_UI_VISION_API_KEY=
PRD_UI_VISION_BASE_URL=https://api.deepseek.com/v1
PRD_UI_VISION_MODEL=deepseek-flash
