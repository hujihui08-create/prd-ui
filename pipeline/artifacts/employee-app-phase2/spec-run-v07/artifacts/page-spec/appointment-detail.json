{
  "meta": {
    "pageId": "appointment-detail",
    "project": "employee-app-phase2",
    "name": "预约详情",
    "target": "mobile",
    "profile": "b-mobile",
    "archetype": "detail",
    "purpose": "查看预约完整信息与状态相关动作；底部固定操作栏按业务状态切换；客户详情入口在可查看该客户时显示链接，否则只显示客户姓名文本。",
    "route": "/appointments/detail/:id",
    "roles": [
      "store_manager",
      "beautician",
      "front_desk"
    ],
    "reqRefs": [
      "REQ-APPT-001",
      "REQ-APPT-002",
      "REQ-APPT-004",
      "REQ-SHARED-001"
    ],
    "version": "0.1.0"
  },
  "layout": {
    "type": "MobileShell",
    "props": {
      "title": "预约详情",
      "tabs": [
        "appointment-list"
      ],
      "back": true
    },
    "reqRef": "REQ-APPT-001",
    "slots": {
      "summary": [
        {
          "type": "Card",
          "props": {
            "title": "预约详情摘要",
            "badge": "已登记",
            "badgeTone": "warning"
          },
          "children": [
            {
              "type": "List",
              "props": {
                "items": [
                  {
                    "label": "客户",
                    "value": "张女士"
                  },
                  {
                    "label": "手机号",
                    "value": "138****0000"
                  },
                  {
                    "label": "项目",
                    "value": "小气泡"
                  },
                  {
                    "label": "时间段",
                    "value": "11-05 周三 10:00-11:00"
                  },
                  {
                    "label": "护理师",
                    "value": "王美容"
                  },
                  {
                    "label": "门店",
                    "value": "星光店"
                  },
                  {
                    "label": "来源",
                    "value": "电话"
                  },
                  {
                    "label": "创建人",
                    "value": "王美容"
                  },
                  {
                    "label": "创建时间",
                    "value": "2026-11-01 15:20"
                  },
                  {
                    "label": "委派留痕",
                    "value": "—"
                  },
                  {
                    "label": "服务完成",
                    "value": "否"
                  }
                ]
              },
              "id": "appointment-detail.root.summary.0.children.0"
            }
          ],
          "id": "appointment-detail.card.summary"
        }
      ],
      "fields": [
        {
          "type": "Row",
          "props": {
            "gap": "space.2",
            "variant": "filter"
          },
          "children": [
            {
              "type": "Button",
              "props": {
                "label": "改期",
                "emphasis": "ghost",
                "action": "appointment.reschedule"
              },
              "id": "appointment-detail.action.reschedule"
            },
            {
              "type": "Button",
              "props": {
                "label": "客户详情",
                "emphasis": "ghost",
                "action": "customer.view"
              },
              "id": "appointment-detail.action.customer"
            },
            {
              "type": "Button",
              "props": {
                "label": "取消",
                "emphasis": "danger",
                "action": "appointment.cancel"
              },
              "id": "appointment-detail.action.cancel"
            }
          ],
          "id": "appointment-detail.root.fields.0"
        }
      ],
      "actions": [
        {
          "type": "Button",
          "props": {
            "label": "已到店确认",
            "emphasis": "primary",
            "action": "appointment.check-in"
          },
          "id": "appointment-detail.action.checkin"
        },
        {
          "type": "Button",
          "props": {
            "label": "开单",
            "emphasis": "secondary",
            "action": "order.create"
          },
          "id": "appointment-detail.action.open-order"
        }
      ]
    },
    "id": "appointment-detail.page.root"
  },
  "states": {
    "default": {
      "name": "default"
    },
    "loading": {
      "name": "loading"
    },
    "error": {
      "name": "error"
    },
    "disabled": {
      "name": "disabled"
    }
  },
  "interactions": [
    {
      "trigger": "已到店确认",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    },
    {
      "trigger": "接单并确认到店",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    },
    {
      "trigger": "开单",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    },
    {
      "trigger": "改期",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    },
    {
      "trigger": "取消",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    },
    {
      "trigger": "术后告知",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    },
    {
      "trigger": "客户详情",
      "action": "navigate",
      "reqRef": "REQ-APPT-001"
    }
  ],
  "traceability": {
    "reqMap": {
      "REQ-APPT-001": [
        "appointment-detail"
      ],
      "REQ-APPT-002": [
        "appointment-detail"
      ],
      "REQ-APPT-004": [
        "appointment-detail"
      ],
      "REQ-SHARED-001": [
        "appointment-detail"
      ]
    },
    "designDefaults": [],
    "unmapped": []
  },
  "businessStates": [
    {
      "name": "已登记",
      "actions": [
        "appointment.check-in",
        "appointment.accept",
        "order.create",
        "appointment.reschedule",
        "appointment.cancel",
        "customer.view"
      ],
      "note": "待分配时「已到店确认」文案为「接单并确认到店」；仅「已登记」可到店、改期、取消，由系统硬校验；「改期」入口需预约登记 + 客户查看。"
    },
    {
      "name": "已到店",
      "actions": [
        "order.create",
        "treatment.notice.view",
        "customer.view"
      ],
      "note": "底部保留开单；serviceCompleted=true 且告知快照存在时显示「术后告知」；改期与取消不出现。"
    },
    {
      "name": "爽约",
      "actions": [
        "customer.view"
      ],
      "note": "只读说明「爽约已记录入客户档案」；员工端不提供爽约入口；客户详情链接仅在可查看该客户时显示。"
    },
    {
      "name": "已取消",
      "actions": [
        "customer.view"
      ],
      "note": "只读说明「本单已取消」；底部操作栏消失；客户详情链接仅在可查看该客户时显示。"
    }
  ],
  "currentStatus": "已登记",
  "linkedRoutes": {
    "create": "/appointments/form",
    "form": "/appointments/form",
    "detail": "/appointments/detail/:id",
    "customer": "/customers/detail/:id",
    "notice": "/appointments/detail/:id/notice",
    "list": "/appointments"
  }
}
