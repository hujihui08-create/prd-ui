{
  "meta": {
    "pageId": "appointment-list",
    "project": "employee-app-phase2",
    "name": "预约列表",
    "target": "mobile",
    "profile": "b-mobile",
    "archetype": "mobile-list",
    "purpose": "以日历或列表查看预约：默认日历七列（09:00–20:00，60 分钟分格，今天列高亮），可切换列表（按日期分组）；日期默认今天；同时具备我的排单与全店时默认我的排单；支持状态筛选与新增预约。",
    "route": "/appointments",
    "roles": [
      "store_manager",
      "beautician",
      "front_desk"
    ],
    "reqRefs": [
      "REQ-LIST-001",
      "REQ-LIST-002",
      "REQ-LIST-003",
      "REQ-SHARED-001"
    ],
    "version": "0.1.0"
  },
