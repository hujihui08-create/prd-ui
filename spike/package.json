{
  "name": "prd-ui-spike",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "plan": "tsx plan/build-plans.ts",
    "dev:html": "vite --config html/vite.config.ts",
    "build:html": "vite build --config html/vite.config.ts",
    "preview:html": "vite preview --config html/vite.config.ts --port 4173",
