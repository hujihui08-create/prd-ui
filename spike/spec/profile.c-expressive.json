{
  "name": "c-expressive",
  "color": {
    "surface.default": "#FFFFFF",
    "surface.subtle": "#FFF1E6",
    "text.primary": "#1F2937",
    "text.secondary": "#6B7280",
    "action.primary": "#FF5A5F",
    "onAction": "#FFFFFF",
    "border.subtle": "#FDE2D2"
  },
  "space": {
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px"
  },
  "radius": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px"
  },
  "typography": {
    "heading.1": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 28,
      "fontWeight": 700,
      "lineHeight": 36
    },
    "heading.2": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 22,
      "fontWeight": 600,
      "lineHeight": 30
    },
    "heading.3": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 18,
      "fontWeight": 600,
      "lineHeight": 26
    },
    "body.md": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 15,
      "fontWeight": 400,
      "lineHeight": 24
    },
    "label.sm": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 12,
      "fontWeight": 500,
      "lineHeight": 16
    }
  },
  "components": {
    "Button": {
      "variants": {
        "primary": {
          "fill": "color.action.primary",
          "text": "color.onAction"
        },
        "secondary": {
          "fill": "color.surface.default",
          "text": "color.text.primary"
        }
      }
    }
  }
}
