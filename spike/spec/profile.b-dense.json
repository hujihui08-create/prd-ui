{
  "name": "b-dense",
  "color": {
    "surface.default": "#FFFFFF",
    "surface.subtle": "#F3F4F6",
    "text.primary": "#111827",
    "text.secondary": "#6B7280",
    "action.primary": "#030213",
    "onAction": "#FFFFFF",
    "border.subtle": "#E5E7EB"
  },
  "space": {
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px"
  },
  "typography": {
    "heading.1": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 32,
      "fontWeight": 700,
      "lineHeight": 40
    },
    "heading.2": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 24,
      "fontWeight": 600,
      "lineHeight": 32
    },
    "heading.3": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 18,
      "fontWeight": 600,
      "lineHeight": 26
    },
    "body.md": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 14,
      "fontWeight": 400,
      "lineHeight": 20
    },
    "label.sm": {
      "fontFamily": "Noto Sans SC",
      "fontSize": 12,
      "fontWeight": 500,
      "lineHeight": 16
    }
  },
  "components": {
    "Button": {
      "variants": {
        "primary": {
          "fill": "color.action.primary",
          "text": "color.onAction"
        },
        "secondary": {
          "fill": "color.surface.default",
          "text": "color.text.primary"
        }
      }
    }
  }
